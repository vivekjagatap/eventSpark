# Gemini AI API Key (required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# App URL (used for self-referential links and API endpoints)
APP_URL=http://localhost:3000

# Server Port
PORT=3000

# Firebase Service Account (for firebase-admin SDK)
# Either set GOOGLE_APPLICATION_CREDENTIALS to a path, or paste JSON inline:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
